# Reel Studio runtime configuration — copy to .env and edit per deployment.
# Precedence: real environment variables > .env > config.json > defaults.
# How the file is wired into the service: docs/deployment.md.

# The workspace directory holding reel.yaml + reel.py — the studio root or
# any scene dir. The only pipeline location.
REELSTUDIO_WORKSPACE=/path/to/anime_reel

# The chat agent: the model alias and the OpenAI-compatible gateway base
# URL. Point these at any compatible server (local or remote).
REELSTUDIO_AGENT_MODEL=writer
REELSTUDIO_AGENT_BASE_URL=https://llms.berrion.garden/v1

# Optional overrides:
# where config.json lives (default ~/.config/reelstudio/config.json) ...
#REELSTUDIO_CONFIG=/path/to/config.json
# ... and where the .env file itself lives (default: beside the code).
#REELSTUDIO_ENV=/path/to/.env

# Rollout wiring (used by ./rollout.sh — see docs/deployment.md): the systemd
# unit serving the app, the local ComfyUI base URL, and the deployed endpoint
# the script verifies against after building. The public URL is what makes a
# rollout verifiable end to end.
#REELSTUDIO_COMFYUI_SERVICE=comfyui.service
#REELSTUDIO_LOCAL_URL=http://127.0.0.1:8188
#REELSTUDIO_PUBLIC_URL=https://reelstudio.example/reelstudio
